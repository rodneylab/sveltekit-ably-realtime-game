{
	"name": "sqvuably",
	"version": "0.0.1",
	"private": true,
	"description": "SvelteKit Ably Squares Realtime Multiplayer Game",
	"bugs": {
		"url": "https://github.com/rodneylab/sqvuably/issues"
	},
	"license": "BSD-3-Clause",
	"author": "Rodney Lab <ask@rodneylab.com> (@rodneyLab)",
	"repository": {
		"type": "git",
		"url": "https://github.com/rodneylab/sqvuably"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --plugin=prettier-plugin-svelte --check . && eslint .",
		"lint:css": "stylelint \"src/**/*.{css,svelte}\"",
		"format": "prettier --write -astro --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports .",
		"check:formatting": "prettier --check --plugin=prettier-plugin-svelte --plugin=@trivago/prettier-plugin-sort-imports .",
		"knip": "knip"
	},
	"devDependencies": {
		"@capsizecss/core": "^4.1.3",
		"@capsizecss/metrics": "^4.3.0",
		"@commitlint/config-conventional": "^21.2.4",
		"@csstools/css-parser-algorithms": "^4.0.2",
		"@csstools/css-tokenizer": "^4.0.2",
		"@csstools/postcss-global-data": "^4.0.0",
		"@eslint/js": "^10.0.1",
		"@js-temporal/polyfill": "^0.5.1",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@trivago/prettier-plugin-sort-imports": "^6.0.2",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/node": "^24.19.0",
		"@typescript-eslint/eslint-plugin": "^8.72.0",
		"@typescript-eslint/parser": "^8.72.0",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@upstash/redis": "^1.39.0",
		"ably": "^1.2.50",
		"autoprefixer": "^10.6.1",
		"commitlint": "^21.2.3",
		"dompurify": "^3.4.16",
		"esbuild": "^0.28.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"knip": "^6.38.0",
		"postcss": "^8.5.28",
		"postcss-csso": "^6.0.1",
		"postcss-custom-media": "^12.0.2",
		"postcss-html": "^2.0.0",
		"postcss-preset-env": "^11.5.4",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"stylelint": "^17.15.0",
		"stylelint-config-recommended": "^18.0.0",
		"stylelint-config-standard": "^40.0.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-preprocess": "^6.0.5",
		"svgo": "^4.1.0",
		"tslib": "^2.8.1",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.70.1",
		"vite": "^8.3.1",
		"vite-node": "^6.0.0"
	},
	"peerDependencies": {
		"@csstools/css-parser-algorithms": "^2.1.0",
		"@csstools/css-tokenizer": "^2.1.0"
